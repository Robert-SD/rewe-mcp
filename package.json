{
  "name": "rewe-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP) server for REWE (Germany) - store finder, weekly offers, product search, recipes, eBon receipts, online orders, REWE Bonus, favorites, basket & trip planner",
  "main": "dist/index.js",
  "bin": {
    "rewe-mcp": "./dist/index.js",
    "rewe-mcp-cli": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js dist/cli.js",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --http",
    "test": "node --import tsx --test test/*.test.ts",
    "login": "tsx src/cli.ts login",
    "status": "tsx src/cli.ts status",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "rewe",
    "rewe-bonus",
    "supermarket",
    "receipts",
    "ebon",
    "groceries",
    "coupons",
    "ai-agent",
    "claude",
    "cursor"
  ],
  "author": "Robert Schulze Dieckhoff",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "dotenv": "^16.4.7",
    "playwright": "^1.64.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
